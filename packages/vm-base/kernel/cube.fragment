# Changes cube makes on top of nerdbox's kernel config (nerdbox-v0.2.5/).
# Applied with scripts/config after copying the nerdbox config and before
# `make olddefconfig`. nerdbox's kernel/patches/ (vsock datagrams and TSI)
# serve its libkrun VMM and are not applied, so CONFIG_TSI disappears.

# Guest clock from the host (virtio-rtc), for pause and snapshot restore.
CONFIG_RTC_CLASS=y
CONFIG_PTP_1588_CLOCK=y
CONFIG_VIRTIO_RTC=y
CONFIG_VIRTIO_RTC_PTP=y
CONFIG_VIRTIO_RTC_CLASS=y

# EROFS image layers: LZ4 (nerdbox's default) plus zstd for smaller layers.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_ZIP_ZSTD=y

# Root assembly and layer disks.
CONFIG_OVERLAY_FS=y
CONFIG_EXT4_FS=y
CONFIG_EFI_PARTITION=y
CONFIG_VIRTIO_BLK=y

# Devices cube's QEMU machines use.
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y

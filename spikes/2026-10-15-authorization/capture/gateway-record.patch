+/// CAPTURE SPIKE: appends the request (head and up to 4 MiB of body, which is
+/// buffered) to $CUBE_GATEWAY_RECORD as a JSON line; without it, passes through.
+async fn record(request: Request<Incoming>, scheme: &Scheme, host: &str, port: u16, vm: &str) -> Request<Body> {
+    use base64::Engine as _;
+    use std::io::Write as _;
+    let Ok(file) = std::env::var("CUBE_GATEWAY_RECORD") else {
+        return request.map(|b| b.boxed());
+    };
+    let (parts, body) = request.into_parts();
+    let bytes = match body.collect().await {
+        Ok(collected) => collected.to_bytes(),
+        Err(_) => Bytes::new(),
+    };
+    let headers: Vec<(String, String)> = parts
+        .headers
+        .iter()
+        .map(|(k, v)| (k.as_str().to_string(), String::from_utf8_lossy(v.as_bytes()).into_owned()))
+        .collect();
+    let line = serde_json::json!({
+        "time": std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis() as u64,
+        "vm": vm,
+        "scheme": if matches!(scheme, Scheme::Https(_)) { "https" } else { "http" },
+        "host": host, "port": port,
+        "method": parts.method.as_str(),
+        "target": parts.uri.path_and_query().map(|p| p.as_str()).unwrap_or("/"),
+        "version": format!("{:?}", parts.version),
+        "headers": headers,
+        "bodyLength": bytes.len(),
+        "body": base64::engine::general_purpose::STANDARD.encode(&bytes[..bytes.len().min(4 << 20)]),
+    });
+    if let Ok(mut out) = std::fs::OpenOptions::new().create(true).append(true).open(&file) {
+        // One write per line: O_APPEND keeps concurrent requests whole.
+        let _ = out.write_all(format!("{line}\n").as_bytes());
+    }
+    Request::from_parts(parts, Full::new(bytes).map_err(|never| match never {}).boxed())
+}
+
+async fn capture_client<S: tokio::io::AsyncRead + tokio::io::AsyncWrite + Unpin + Send + 'static>(io: S) -> Result<SendRequest<Body>> {
+    let (sender, connection) = hyper::client::conn::http1::handshake(TokioIo::new(io)).await?;
+    tokio::spawn(async move { let _ = connection.await; });
+    Ok(sender)
+}

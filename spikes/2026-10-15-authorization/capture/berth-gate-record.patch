+
+/// CAPTURE SPIKE: appends the request (head and up to 4 MiB of body, which is
+/// buffered) to $BERTH_GATE_RECORD as one JSON line; without it, passes through.
+async fn record(request: Request<Incoming>, scheme: Scheme, host: &str, port: u16) -> Request<Body> {
+    use std::io::Write as _;
+    let Ok(file) = std::env::var("BERTH_GATE_RECORD") else {
+        return request.map(|b| b.boxed());
+    };
+    let (parts, body) = request.into_parts();
+    let bytes = match body.collect().await {
+        Ok(collected) => collected.to_bytes(),
+        Err(_) => Bytes::new(),
+    };
+    let headers: Vec<(String, String)> = parts
+        .headers
+        .iter()
+        .map(|(k, v)| (k.as_str().to_string(), String::from_utf8_lossy(v.as_bytes()).into_owned()))
+        .collect();
+    let line = serde_json::json!({
+        "time": std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap().as_millis() as u64,
+        "scheme": if matches!(scheme, Scheme::Https) { "https" } else { "http" },
+        "host": host, "port": port,
+        "method": parts.method.as_str(),
+        "target": parts.uri.path_and_query().map(|p| p.as_str()).unwrap_or("/"),
+        "version": format!("{:?}", parts.version),
+        "headers": headers,
+        "bodyLength": bytes.len(),
+        "body": b64(&bytes[..bytes.len().min(4 << 20)]),
+    });
+    if let Ok(mut out) = std::fs::OpenOptions::new().create(true).append(true).open(&file) {
+        // One write per line: O_APPEND keeps concurrent requests whole.
+        let _ = out.write_all(format!("{line}\n").as_bytes());
+    }
+    Request::from_parts(parts, Full::new(bytes).map_err(|never| match never {}).boxed())
+}
+
+/// CAPTURE SPIKE: standard base64 (berth has no base64 dependency outside tests).
+fn b64(data: &[u8]) -> String {
+    const T: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    let mut out = String::with_capacity(data.len().div_ceil(3) * 4);
+    for chunk in data.chunks(3) {
+        let n = (chunk[0] as u32) << 16 | (*chunk.get(1).unwrap_or(&0) as u32) << 8 | *chunk.get(2).unwrap_or(&0) as u32;
+        for i in 0..4 {
+            if i <= chunk.len() { out.push(T[(n >> (18 - 6 * i) & 63) as usize] as char) } else { out.push('=') }
+        }
+    }
+    out
+}

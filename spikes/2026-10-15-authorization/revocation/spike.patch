diff --git a/scripts/spike-revoke-disconnect.ts b/scripts/spike-revoke-disconnect.ts
new file mode 100644
index 000000000..5948c77bc
--- /dev/null
+++ b/scripts/spike-revoke-disconnect.ts
@@ -0,0 +1,54 @@
+/** SPIKE (authorization 4c): when does berth learn that cubed is gone?
+ * A child process (cubed's RunnerSession) connects and revokes once, then
+ * either closes the session or is SIGKILLed; the parent reads berth's
+ * "connection ended" line (unix ns) and prints the delay.
+ *   node scripts/spike-revoke-disconnect.ts <berth> <loopback|relay> <close|kill> <dir> */
+import fs from "node:fs";
+import path from "node:path";
+import { execFileSync, spawn } from "node:child_process";
+import { once } from "node:events";
+import { RunnerSession, loadSessionConfig } from "../packages/server/src/runner-session.ts";
+
+const [binaryArg, mode, how, dirArg] = process.argv.slice(2);
+if (how === "child") {
+  const session = new RunnerSession(loadSessionConfig(dirArg!).config);
+  await session.hello();
+  await session.call({ case: "grantRevoke", value: { ids: ["rid-before-disconnect"], generation: 1n } });
+  process.stdout.write("ready\n");
+  process.stdin.on("data", async () => { await session.close(); process.stdout.write(`closed ${Date.now()}\n`); process.exit(0); });
+} else {
+  const binary = path.resolve(binaryArg!);
+  const root = path.resolve(dirArg!);
+  fs.rmSync(root, { recursive: true, force: true });
+  fs.mkdirSync(root, { recursive: true });
+  const controlKey = path.join(root, "control.key");
+  const control = JSON.parse(execFileSync(binary, ["keygen", "--key", controlKey], { encoding: "utf8" })) as { peerId: string };
+  const net = mode === "relay" ? ["--network", "relay"] : ["--listen", "127.0.0.1:0"];
+  const berth = spawn(binary, ["host", "--dir", path.join(root, "host"), "--allow-peer", control.peerId, "--node-id", "node-spike-c", ...net],
+    { stdio: ["ignore", "ignore", "pipe"], env: { ...process.env, BERTH_SPIKE_GATE: "127.0.0.1:0" } });
+  let banner = "";
+  berth.stderr!.setEncoding("utf8");
+  berth.stderr!.on("data", chunk => { banner += chunk; });
+  const until = async (re: RegExp, ms: number) => {
+    const deadline = Date.now() + ms;
+    while (!re.test(banner)) { if (Date.now() > deadline) throw new Error(`timeout waiting for ${re}`); await new Promise(r => setTimeout(r, 5)); }
+    return banner.match(re)!;
+  };
+  await until(/^spike gate: .+\n/m, 30000);
+  const field = (name: string) => banner.match(new RegExp(`^${name}: (.+)$`, "m"))?.[1]?.trim() ?? "";
+  const configPath = path.join(root, "runner.json");
+  fs.writeFileSync(configPath, JSON.stringify({ version: 2, protocol: 4, binding: { nodeId: "node-spike-c", threadId: "t", environmentId: 1 },
+    controlKey, serverPeer: field("peer"), network: mode, ...(mode === "loopback" ? { address: field("listen").split(", ")[0] } : {}) }), { mode: 0o600 });
+  const child = spawn(process.execPath, [import.meta.filename, "", mode!, "child", configPath], { stdio: ["pipe", "pipe", "inherit"] });
+  let out = "";
+  child.stdout!.setEncoding("utf8");
+  child.stdout!.on("data", c => { out += c; });
+  while (!out.includes("ready")) await new Promise(r => setTimeout(r, 5));
+  await new Promise(r => setTimeout(r, 2000));
+  const at = BigInt(Date.now()) * 1_000_000n;
+  if (how === "kill") child.kill("SIGKILL"); else child.stdin!.write("close\n");
+  const ended = await until(/connection from cubed ended at (\d+) \(([^)]*)\)/, 120000);
+  console.log(JSON.stringify({ mode, how, detectMs: Number(BigInt(ended[1]!) - at) / 1e6, reason: ended[2] }));
+  berth.kill("SIGINT");
+  await once(berth, "exit");
+}
diff --git a/scripts/spike-revoke-timing.ts b/scripts/spike-revoke-timing.ts
new file mode 100644
index 000000000..ada3d991e
--- /dev/null
+++ b/scripts/spike-revoke-timing.ts
@@ -0,0 +1,136 @@
+/** SPIKE (authorization 4c): how fast a revocation from cubed reaches a
+ * protocol-4 runner's gate. A real `berth host` (spike build: grant_revoke
+ * and a loopback gate check, BERTH_SPIKE_GATE) and cubed's RunnerSession
+ * over real Iroh.
+ *
+ *   node scripts/spike-revoke-timing.ts <berth> <loopback|relay> <dir> [n=1000]
+ *
+ * Prints one JSON line: runner_get and grant_revoke round trips, the
+ * one-way time to the runner's set (send -> applied, same host clock), and
+ * send -> the first refusal a prober in a worker thread sees at the gate. */
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import net from "node:net";
+import path from "node:path";
+import { execFileSync, spawn, type ChildProcess } from "node:child_process";
+import { once } from "node:events";
+import { Worker } from "node:worker_threads";
+import { RunnerSession, loadSessionConfig } from "../packages/server/src/runner-session.ts";
+
+const binary = path.resolve(process.argv[2]!);
+const mode = process.argv[3] as "loopback" | "relay";
+const root = path.resolve(process.argv[4]!);
+const n = Number(process.argv[5] ?? 1000);
+assert.ok(mode === "loopback" || mode === "relay");
+fs.rmSync(root, { recursive: true, force: true });
+fs.mkdirSync(root, { recursive: true });
+const now = () => performance.timeOrigin + performance.now(); // ms, wall clock, us precision
+const controlKey = path.join(root, "control.key");
+const control = JSON.parse(execFileSync(binary, ["keygen", "--key", controlKey], { encoding: "utf8" })) as { peerId: string };
+
+const net_ = mode === "relay" ? ["--network", "relay"] : ["--listen", "127.0.0.1:0"];
+const child: ChildProcess = spawn(binary, ["host", "--dir", path.join(root, "host"), "--allow-peer", control.peerId, "--node-id", "node-spike-c", ...net_],
+  { stdio: ["ignore", "ignore", "pipe"], env: { ...process.env, BERTH_SPIKE_GATE: "127.0.0.1:0" } });
+let banner = "";
+const log = fs.createWriteStream(path.join(root, "berth.log"));
+child.stderr!.setEncoding("utf8");
+child.stderr!.on("data", chunk => { banner += chunk; log.write(chunk); });
+await new Promise<void>((resolve, reject) => {
+  const check = () => { if (/^spike gate: .+\n/m.test(banner)) resolve(); };
+  child.stderr!.on("data", check);
+  child.once("exit", code => reject(new Error(`berth exited (${code}): ${banner}`)));
+});
+const field = (name: string) => banner.match(new RegExp(`^${name}: (.+)$`, "m"))?.[1]?.trim() ?? "";
+const gate = field("spike gate");
+const configPath = path.join(root, "runner.json");
+fs.writeFileSync(configPath, JSON.stringify({ version: 2, protocol: 4, binding: { nodeId: "node-spike-c", threadId: "t", environmentId: 1 },
+  controlKey, serverPeer: field("peer"), network: mode, ...(mode === "loopback" ? { address: field("listen").split(", ")[0] } : {}) }), { mode: 0o600 });
+const session = new RunnerSession(loadSessionConfig(configPath).config);
+
+function stats(values: number[]) {
+  const v = [...values].sort((a, b) => a - b);
+  const at = (q: number) => +v[Math.min(v.length - 1, Math.round(q * (v.length - 1)))]!.toFixed(3);
+  return { n: v.length, p50: at(0.5), p95: at(0.95), p99: at(0.99), max: +v.at(-1)!.toFixed(3), min: +v[0]!.toFixed(3) };
+}
+
+// The prober: its own event loop, one TCP connection to the gate, checking
+// the current round's grant id until it is refused.
+const shared = new SharedArrayBuffer(64);
+const round = new Int32Array(shared, 0, 4); // [round, allowsSeenThisRound, deniedRound, stop]
+const times = new Float64Array(shared, 16, 4); // [deniedAt]
+const worker = new Worker(`
+  const { workerData } = require("node:worker_threads");
+  const net = require("node:net");
+  const round = new Int32Array(workerData.shared, 0, 4);
+  const times = new Float64Array(workerData.shared, 16, 4);
+  const now = () => performance.timeOrigin + performance.now();
+  const [host, port] = workerData.gate.split(":");
+  const socket = net.connect({ host, port: Number(port), noDelay: true });
+  let buffer = "";
+  let asked = -1;
+  const ask = () => {
+    if (Atomics.load(round, 3)) { socket.end(); return; }
+    asked = Atomics.load(round, 0);
+    socket.write("rid-" + asked + " api.github.com\\n");
+  };
+  socket.on("connect", ask);
+  socket.on("data", chunk => {
+    buffer += chunk;
+    let i;
+    while ((i = buffer.indexOf("\\n")) >= 0) {
+      const line = buffer.slice(0, i); buffer = buffer.slice(i + 1);
+      if (line === "deny revoked" && Atomics.load(round, 2) !== asked) { times[0] = now(); Atomics.store(round, 2, asked); }
+      else if (line === "allow" && asked === Atomics.load(round, 0)) Atomics.add(round, 1, 1);
+      ask();
+    }
+  });
+`, { eval: true, workerData: { shared, gate } });
+
+try {
+  const started = now();
+  await session.hello();
+  const warm = mode === "relay" ? 20 : 100;
+  // (a) a cheap existing call: runner_get, then machine_list
+  const rtt = async (verb: Parameters<RunnerSession["call"]>[0], count: number) => {
+    const samples: number[] = [];
+    for (let i = 0; i < warm + count; i++) {
+      const t0 = now();
+      if (process.env.SPIKE_GC && i % 50 === 0) (globalThis as { gc?: () => void }).gc?.();
+      try { await session.call(verb); }
+      catch (error) { throw new Error(`${verb.case} #${i} after ${(now() - started).toFixed(0)} ms: ${String(error)}`); }
+      if (i >= warm) samples.push(now() - t0);
+    }
+    return samples;
+  };
+  const runnerGet = await rtt({ case: "runnerGet", value: {} }, n);
+  const machineList = await rtt({ case: "machineList", value: {} }, n);
+  // (a') + (c): grant_revoke, with the prober at the gate
+  const revokeRtt: number[] = [], oneWay: number[] = [], toRefusal: number[] = [];
+  let delivered = 0;
+  for (let i = 1; i <= warm + n; i++) {
+    Atomics.store(round, 1, 0);
+    Atomics.store(round, 0, i);
+    // the prober has seen this round's grant allowed at least once
+    while (Atomics.load(round, 1) < 1) await new Promise(resolve => setImmediate(resolve));
+    const t0 = now();
+    const answer = await session.call({ case: "grantRevoke", value: { ids: [`rid-${i}`], generation: BigInt(i) } });
+    const t1 = now();
+    assert.equal(answer.case, "revoked");
+    while (Atomics.load(round, 2) !== i) await new Promise(resolve => setImmediate(resolve));
+    if (i <= warm) continue;
+    if (answer.case === "revoked" && answer.value.generation === BigInt(i)) delivered++;
+    revokeRtt.push(t1 - t0);
+    oneWay.push(Number(answer.case === "revoked" ? answer.value.appliedUnixNanos : 0n) / 1e6 - t0);
+    toRefusal.push(times[0]! - t0);
+  }
+  Atomics.store(round, 3, 1);
+  const paths = [...banner.matchAll(/^spike: path (.+)$/gm)].map(m => m[1]).slice(-4);
+  console.log(JSON.stringify({ mode, n, delivered, unit: "ms",
+    runnerGetRtt: stats(runnerGet), machineListRtt: stats(machineList), grantRevokeRtt: stats(revokeRtt),
+    sendToApplied: stats(oneWay), sendToRefusal: stats(toRefusal), paths }));
+} finally {
+  await worker.terminate();
+  await session.close();
+  if (child.exitCode === null) { const exited = once(child, "exit"); child.kill("SIGINT"); await exited; }
+  log.end();
+}

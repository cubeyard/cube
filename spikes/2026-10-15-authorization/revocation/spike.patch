index 000000000..8596b0add
--- /dev/null
+++ b/packages/berth/src/spike_revoke.rs
@@ -0,0 +1,227 @@
+//! SPIKE (authorization 4c, not for merging): a runner-wide set of revoked
+//! grant ids, filled by cubed's `grant_revoke` call and checked first by a
+//! gate-like check that also runs the machine's real `Policy::decide`.
+//! `BERTH_SPIKE_GATE=127.0.0.1:PORT` serves that check on loopback TCP: one
+//! line per request, `<grant id> <host>`, answered `allow`, `deny revoked` or
+//! `deny <reason>`.
+use std::{
+    collections::HashSet,
+    sync::{Arc, LazyLock, Mutex},
+    time::{SystemTime, UNIX_EPOCH},
+};
+
+use cube_runner_protocol::proto::{self, call_result, egress_policy};
+use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
+
+use crate::vm::policy::{Policy, Scheme};
+
+pub fn unix_nanos() -> i64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap()
+        .as_nanos() as i64
+}
+
+/// A policy shaped as cubed's `policyFor` makes it: public HTTP(S), one
+/// credential rule per secret, the 15-minute lease.
+pub fn realistic_policy() -> Policy {
+    let credential = |name: &str, hosts: &[&str]| egress_policy::Rule {
+        hosts: hosts.iter().map(|h| h.to_string()).collect(),
+        ports: vec![],
+        kind: Some(egress_policy::rule::Kind::Https(egress_policy::Https {
+            credential: Some(egress_policy::Credential { name: name.into() }),
+        })),
+    };
+    Policy::from_proto(Some(&proto::EgressPolicy {
+        default: egress_policy::Default::AllowPublicHttp as i32,
+        deny_hosts: vec!["metadata.google.internal".into(), "*.internal".into()],
+        rules: vec![
+            credential("github", &["github.com", "api.github.com", "*.githubusercontent.com"]),
+            credential("anthropic", &["api.anthropic.com"]),
+            credential("npm", &["registry.npmjs.org"]),
+        ],
+        lease: Some(pbjson_types::Duration { seconds: 900, nanos: 0 }),
+    }))
+    .unwrap()
+}
+
+pub struct SpikeGate {
+    /// As `Gate.policy`: replaced whole by each machine_start.
+    pub policy: Mutex<Arc<Policy>>,
+    /// Runner-wide, checked before the policy.
+    pub revoked: Mutex<HashSet<String>>,
+    pub generation: Mutex<u64>,
+}
+
+impl SpikeGate {
+    pub fn new() -> Self {
+        Self {
+            policy: Mutex::new(Arc::new(realistic_policy())),
+            revoked: Mutex::default(),
+            generation: Mutex::new(0),
+        }
+    }
+
+    pub fn revoke<'a>(&self, ids: impl IntoIterator<Item = &'a String>, generation: u64) -> u32 {
+        let mut revoked = self.revoked.lock().unwrap();
+        for id in ids {
+            revoked.insert(id.clone());
+        }
+        let mut current = self.generation.lock().unwrap();
+        *current = (*current).max(generation);
+        revoked.len() as u32
+    }
+
+    /// None: allowed; Some(reason): denied.
+    pub fn check(&self, grant: &str, host: &str) -> Option<&'static str> {
+        if self.revoked.lock().unwrap().contains(grant) {
+            return Some("revoked");
+        }
+        let policy = self.policy.lock().unwrap().clone();
+        policy
+            .decide(Scheme::Https, host, 443, &[])
+            .err()
+            .map(|denial| denial.reason())
+    }
+}
+
+pub static GATE: LazyLock<SpikeGate> = LazyLock::new(SpikeGate::new);
+
+pub fn apply(revoke: &proto::GrantRevoke) -> proto::CallResult {
+    let count = GATE.revoke(&revoke.ids, revoke.generation);
+    let applied = unix_nanos();
+    proto::CallResult {
+        result: Some(call_result::Result::Revoked(proto::Revoked {
+            generation: *GATE.generation.lock().unwrap(),
+            count,
+            applied_unix_nanos: applied,
+        })),
+    }
+}
+
+pub fn serve_gate_from_env() {
+    let Some(address) = std::env::var_os("BERTH_SPIKE_GATE") else {
+        return;
+    };
+    let address = address.into_string().unwrap();
+    tokio::spawn(async move {
+        let listener = tokio::net::TcpListener::bind(&address).await.unwrap();
+        eprintln!("spike gate: {}", listener.local_addr().unwrap());
+        loop {
+            let Ok((socket, _)) = listener.accept().await else { continue };
+            socket.set_nodelay(true).ok();
+            tokio::spawn(async move {
+                let (read, mut write) = socket.into_split();
+                let mut lines = BufReader::new(read).lines();
+                while let Ok(Some(line)) = lines.next_line().await {
+                    let (grant, host) = line.split_once(' ').unwrap_or((&line, "example.com"));
+                    let answer = match GATE.check(grant, host) {
+                        None => "allow\n".to_string(),
+                        Some(reason) => format!("deny {reason}\n"),
+                    };
+                    if write.write_all(answer.as_bytes()).await.is_err() {
+                        break;
+                    }
+                }
+            });
+        }
+    });
+}
+
+#[cfg(test)]
+mod bench {
+    //! `cargo test --release -p berth spike_revoke -- --ignored --nocapture`
+    use super::*;
+    use std::{
+        sync::atomic::{AtomicBool, AtomicU64, Ordering},
+        time::Instant,
+    };
+
+    fn pct(mut v: Vec<u64>) -> String {
+        v.sort_unstable();
+        let at = |q: f64| v[((v.len() - 1) as f64 * q).round() as usize];
+        format!(
+            "n={} p50={}ns p95={}ns p99={}ns max={}ns",
+            v.len(),
+            at(0.5),
+            at(0.95),
+            at(0.99),
+            v[v.len() - 1]
+        )
+    }
+
+    fn filled(n: usize) -> SpikeGate {
+        let gate = SpikeGate::new();
+        let ids: Vec<String> = (0..n).map(|i| format!("{:064x}", i)).collect();
+        gate.revoke(&ids, 1);
+        gate
+    }
+
+    #[test]
+    #[ignore]
+    fn spike_revoke_bench() {
+        const N: usize = 20_000;
+        for size in [0usize, 1_000, 100_000] {
+            // (1) apply one revocation: insert under the mutex.
+            let gate = filled(size);
+            let ids: Vec<String> = (0..N).map(|i| format!("new-{i:060x}")).collect();
+            let mut apply = Vec::with_capacity(N);
+            for id in &ids {
+                let t = Instant::now();
+                gate.revoke(std::iter::once(id), 2);
+                apply.push(t.elapsed().as_nanos() as u64);
+            }
+            // (2) a decide (revoked check + Policy::decide), allowed and refused.
+            let mut allowed = Vec::with_capacity(N);
+            let mut refused = Vec::with_capacity(N);
+            for (i, id) in ids.iter().enumerate() {
+                let fresh = format!("live-{i}");
+                let t = Instant::now();
+                assert_eq!(gate.check(&fresh, "api.github.com"), None);
+                allowed.push(t.elapsed().as_nanos() as u64);
+                let t = Instant::now();
+                assert_eq!(gate.check(id, "api.github.com"), Some("revoked"));
+                refused.push(t.elapsed().as_nanos() as u64);
+            }
+            // (3) the copy-on-write alternative: the set inside the policy,
+            // replaced whole as Gate::replace does.
+            let cow: Mutex<Arc<HashSet<String>>> =
+                Mutex::new(Arc::new((0..size).map(|i| format!("{:064x}", i)).collect()));
+            let mut replace = Vec::with_capacity(200);
+            for id in ids.iter().take(200) {
+                let t = Instant::now();
+                let mut next = (**cow.lock().unwrap()).clone();
+                next.insert(id.clone());
+                *cow.lock().unwrap() = Arc::new(next);
+                replace.push(t.elapsed().as_nanos() as u64);
+            }
+            // (4) revoke -> refusal on another thread spinning on check.
+            let gate = Arc::new(filled(size));
+            let mut cross = Vec::with_capacity(2000);
+            for round in 0..2000u64 {
+                let id = format!("x-{round}");
+                let go = Arc::new(AtomicBool::new(false));
+                let seen = Arc::new(AtomicU64::new(0));
+                let origin = Instant::now();
+                let spinner = {
+                    let (gate, go, seen, id) = (gate.clone(), go.clone(), seen.clone(), id.clone());
+                    std::thread::spawn(move || {
+                        go.store(true, Ordering::SeqCst);
+                        while gate.check(&id, "api.github.com").is_none() {}
+                        seen.store(origin.elapsed().as_nanos() as u64, Ordering::SeqCst);
+                    })
+                };
+                while !go.load(Ordering::SeqCst) {}
+                let sent = origin.elapsed().as_nanos() as u64;
+                gate.revoke(std::iter::once(&id), round);
+                spinner.join().unwrap();
+                cross.push(seen.load(Ordering::SeqCst).saturating_sub(sent));
+            }
+            println!("set={size} apply(insert under mutex): {}", pct(apply));
+            println!("set={size} check allowed (revoked lookup + Policy::decide): {}", pct(allowed));
+            println!("set={size} check refused (revoked): {}", pct(refused));
+            println!("set={size} copy-on-write replace (clone set + insert + swap): {}", pct(replace));
+            println!("set={size} revoke -> refusal seen by a spinning gate thread: {}", pct(cross));
+        }
+    }
+}

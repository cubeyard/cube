#cloud-config
password: spike
chpasswd: { expire: false }
ssh_pwauth: false
runcmd:
  - |
    exec > /dev/ttyS1 2>&1
    echo "=== SPIKE BEGIN"
    ip -br addr; ip route; ip link show | grep mtu
    resolvectl status | grep -E "DNS Servers|Current DNS" || cat /etc/resolv.conf
    echo "--- apt-get update"; t=$(date +%s%N); apt-get update -q 2>&1 | tail -2; echo "apt-get update $(( ($(date +%s%N)-t)/1000000 )) ms"
    command -v git >/dev/null || apt-get install -y -q git >/dev/null 2>&1
    nstat -az TcpRetransSegs TcpExtTCPLostRetransmit TcpExtTCPTimeouts TcpExtTCPOFOQueue TcpInSegs 2>/dev/null || cat /proc/net/snmp | grep Tcp
    echo "--- git clone"; t=$(date +%s%N); git clone -q --depth 1 https://github.com/cubeyard/cube /tmp/cube 2>&1 && du -sh /tmp/cube; echo "git clone $(( ($(date +%s%N)-t)/1000000 )) ms"
    echo "=== SPIKE END"
    poweroff

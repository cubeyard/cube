#!/usr/bin/env bash
# Runs inside the development environment only. No daemons or host credentials.
set -euo pipefail
trap 'echo "[setup] failed at line $LINENO" >&2' ERR
root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
log() { printf '[setup] %s\n' "$*"; }
fetch() { curl --fail --silent --show-error --location --retry 2 --connect-timeout 15 --max-time 180 "$1" -o "$2"; }

# Match the shipped runtime rather than the older Node in the base guest image.
node_version="$(sed -n 's/^NODE_VERSION=//p' scripts/vm/build-app.sh)"
[[ "$node_version" =~ ^v26\.[0-9]+\.[0-9]+$ ]]
rust_version="$(sed -n 's/^channel = "\([^"]*\)"/\1/p' rust-toolchain.toml)"
[[ "$rust_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
rustup_version=1.28.2
case "$(uname -s)/$(uname -m)" in
  Linux/x86_64) node_arch=x64; rust_target=x86_64-unknown-linux-gnu ;;
  Linux/aarch64) node_arch=arm64; rust_target=aarch64-unknown-linux-gnu ;;
  *) log 'unsupported development environment: expected Linux x86_64 or aarch64'; exit 1 ;;
esac

log 'native build dependencies'
packages=(build-essential pkg-config libssl-dev ca-certificates curl xz-utils)
missing=()
for package in "${packages[@]}"; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo -n apt-get update -qq
  sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi

base="$HOME/.local/share/cube-dev"
mkdir -p "$base"
work="$(mktemp -d "$base/setup.XXXXXX")"
trap 'rm -rf -- "$work"' EXIT
node_home="$base/node-$node_version-linux-$node_arch"
if [[ ! -x "$node_home/bin/node" ]] || [[ "$("$node_home/bin/node" --version)" != "$node_version" ]]; then
  log "install node $node_version"
  archive="node-$node_version-linux-$node_arch.tar.xz"
  fetch "https://nodejs.org/dist/$node_version/$archive" "$work/$archive"
  fetch "https://nodejs.org/dist/$node_version/SHASUMS256.txt" "$work/SHASUMS256.txt"
  (cd "$work"; awk -v name="$archive" '$2 == name { print }' SHASUMS256.txt > checksum; test "$(wc -l < checksum)" -eq 1; sha256sum --check checksum)
  tar -xJf "$work/$archive" -C "$work"
  # A prior interrupted/incomplete install is not usable.
  rm -rf -- "$node_home"
  mv "$work/node-$node_version-linux-$node_arch" "$node_home"
fi
export PATH="$node_home/bin:$HOME/.cargo/bin:$PATH"

log "rust $rust_version (rustup bootstrap $rustup_version)"
if [[ ! -x "$HOME/.cargo/bin/rustup" ]]; then
  url="https://static.rust-lang.org/rustup/archive/$rustup_version/$rust_target/rustup-init"
  fetch "$url" "$work/rustup-init"
  fetch "$url.sha256" "$work/rustup-init.sha256"
  (cd "$work"; sha256sum --check rustup-init.sha256)
  chmod 700 "$work/rustup-init"
  "$work/rustup-init" -y --no-modify-path --profile minimal --default-toolchain none
fi
# Keep bootstrap reruns from silently updating rustup itself.
rustup set auto-self-update disable
# Honor the repository pin, including components, without updating other toolchains.
rustup toolchain install "$rust_version" --profile minimal --component rustfmt --component clippy

log 'persist development PATH for login shells'
path_file="$base/env.sh"
printf 'export PATH="%s/bin:$HOME/.cargo/bin:$PATH"\n' "$node_home" > "$work/env.sh"
mv "$work/env.sh" "$path_file"
source_line='. "$HOME/.local/share/cube-dev/env.sh" # cube development tools'
# bash chooses the first existing login file; .profile also covers sh logins.
for profile in "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bash_login"; do
  if [[ "$profile" == "$HOME/.profile" || -f "$profile" ]]; then
    if ! grep -qxF "$source_line" "$profile" 2>/dev/null; then
      printf '\n%s\n' "$source_line" >> "$profile"
    fi
  fi
done

pnpm_version="$(node -p 'JSON.parse(require("fs").readFileSync("package.json", "utf8")).packageManager.replace(/^pnpm@/, "")')"
[[ "$pnpm_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]
if [[ ! -x "$node_home/bin/pnpm" ]] || [[ "$("$node_home/bin/pnpm" --version)" != "$pnpm_version" ]]; then
  log "install pnpm $pnpm_version"
  npm install --global --prefix "$node_home" --no-audit --no-fund "pnpm@$pnpm_version"
fi
log 'install locked workspace dependencies'
pnpm install --frozen-lockfile
log 'verify toolchain'
node --version
pnpm --version
rustc --version
cargo --version
cc --version | sed -n '1p'
pkg-config --modversion openssl
log 'complete'
